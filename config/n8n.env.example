# Example environment for a local, self-hosted n8n instance running Jobhunter AI Agent.
# Optional: n8n works without this file. Copy the values you need into your own
# environment (never commit a real .env file). Variable names follow the n8n docs:
# https://docs.n8n.io/hosting/configuration/environment-variables/

# Time zone used by the Schedule Trigger (the workflow itself also sets Europe/Rome).
GENERIC_TIMEZONE=Europe/Rome

# Bind the editor to this machine only, so it is not reachable from other devices
# on the same network (for example public Wi-Fi).
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Keep execution history small: executions can contain job data and request details.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Do not store data for successful scheduled runs (failed runs are still kept).
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
