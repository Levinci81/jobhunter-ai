    {
      "parameters": {
        "jsCode": "const text = (value) => {\n  if (value === undefined || value === null) return '';\n  if (Array.isArray(value)) return value.map(text).filter(Boolean).join(', ');\n  if (typeof value === 'object') return '';\n  return String(value).trim();\n};\n\nconst toIsoDate = (value) => {\n  if (value === undefined || value === null || value === '') return '';\n  const numeric = Number(value);\n  if (!Number.isFinite(numeric)) return text(value);\n  const date = new Date(numeric * 1000);\n  return Number.isNaN(date.getTime()) ? '' : date.toISOString();\n};\n\nconst isHttpUrl = (value) => /^https?:\\/\\/\\S+$/i.test(value);\n\nreturn $input.all()\n  .map(item => ({\n    json: {\n      title: text(item.json.title),\n      company: text(item.json.company_name || item.json.company),\n      location: text(item.json.candidate_required_location || item.json.location),\n      salary: text(item.json.salary),\n      job_type: text(item.json.job_type || item.json.job_types),\n      language: text(item.json.language),\n      remote_region: text(item.json.candidate_required_location || item.json.location),\n      source: text(item.json.source) || 'arbeitnow',\n      date: toIsoDate(item.json.publication_date || item.json.created_at),\n      url: text(item.json.url)\n    }\n  }))\n  .filter(item => isHttpUrl(item.json.url));"
      },
