    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst escapeHtml = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/'/g, '&#39;');\n\nconst safeUrl = (value) => {\n  const url = String(value || '').trim();\n  return /^https?:\\/\\//i.test(url) ? escapeHtml(url) : '';\n};\n\nlet html = `\n<h2>Jobhunter AI Agent – Neue Jobtreffer</h2>\n<p>Es wurden <strong>${items.length}</strong> passende Jobs gefunden.</p>\n<hr>\n`;\n\nitems.forEach((item, index) => {\n  const job = item.json;\n\n  const title = escapeHtml(job.title || job.name || 'Stellenangebot');\n  const url = safeUrl(job.url || job.link);\n  const company = escapeHtml(job.company || job.company_name || job.companyName || '');\n  const source = escapeHtml(job.source || '');\n\n  html += `\n    <h3>${index + 1}. ${title}</h3>\n    ${company ? `<p><strong>Unternehmen:</strong> ${company}</p>` : ''}\n    ${source ? `<p><strong>Quelle:</strong> ${source}</p>` : ''}\n    ${url ? `<p><a href=\"${url}\">Stellenanzeige öffnen</a></p>` : ''}\n    <hr>\n  `;\n});\n\nreturn [\n  {\n    json: {\n      subject: `Jobhunter AI Agent – ${items.length} neue Jobtreffer`,\n      html\n    }\n  }\n];"
      },
